{
    "name": "CIS 047 Web Development Course",
    "image": "mcr.microsoft.com/devcontainers/php:1-8.2-apache",
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "18"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {}
    },
    "containerEnv": {
        "APACHE_DOCUMENT_ROOT": "/workspaces/cis047-course-template/public"
    },
    "remoteUser": "root",
    "postCreateCommand": "apt-get update && apt-get install -y mysql-client && a2enmod rewrite",
    "forwardPorts": [80, 3000, 3306],
    "portsAttributes": {
        "80": {
            "label": "Application",
            "onAutoForward": "notify"
        },
        "3306": {
            "label": "MySQL",
            "onAutoForward": "silent"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.vscode-live-server",
                "formulahendry.auto-close-tag",
                "formulahendry.auto-rename-tag",
                "esbenp.prettier-vscode",
                "dbaeumer.vscode-eslint",
                "felixbecker.php-debug",
                "bmewburn.vscode-intellicode-api"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "editor.defaultFormatter": "esbenp.prettier-vscode",
                "[php]": {
                    "editor.defaultFormatter": "felixbecker.php-pack"
                }
            }
        }
    }
}
